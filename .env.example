# kafka-up: optional SCRAM credentials for --auth mode.
#
# Copy this file to .env to override the built-in defaults. Without
# .env, the values below are used as-is, which is fine for local dev.
#
# .env is gitignored. Don't commit real credentials.

# Main service account used by host-side clients hitting 9093/9094/9095.
KAFKA_UP_USER=kafkaup
KAFKA_UP_PASSWORD_256=kafkaup-dev-256
KAFKA_UP_PASSWORD_512=kafkaup-dev-512

# Admin user with broad permissions for cluster ops.
KAFKA_UP_ADMIN_USER=admin
KAFKA_UP_ADMIN_PASSWORD=admin-secret

# Read-only user for verifying consume paths.
KAFKA_UP_READONLY_USER=readonly
KAFKA_UP_READONLY_PASSWORD=readonly-secret
